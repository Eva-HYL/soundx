# deploy/.env.example
# 复制成 deploy/.env 后按需修改。docker compose 会自动读同目录的 .env

# ============== 基础服务 ==============
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=soundx
MYSQL_PORT=3306
REDIS_PORT=6379

# ============== API 容器（仅 docker-compose.prod.yml 用得上） ==============
NODE_ENV=production
API_PORT=3000

# DATABASE_URL 里的 host 要写 compose 的服务名，不是 localhost
# 如果 API 也在 docker 里跑，host=mysql；如果 API 在宿主机跑，host=localhost
DATABASE_URL=mysql://soundx_app:soundx_app_change_me@mysql:3306/soundx
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# 微信小程序（留空也能跑：AuthService 会走 dev stub）
WX_APP_ID=
WX_APP_SECRET=

# 对象存储（生产换成 OSS/S3，开发 local 即可）
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=soundx-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=http://localhost:3000/static

# Admin 和 Miniapp H5 部署时把域名加进来，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
